# 只有 provider=local（或線上金鑰都沒設定時的當日摘要 fallback）才會用到本地模型，
# 需要另外安裝 requirements-local-llm.txt。
# 固定使用 openbmb/MiniCPM5-2B（CPU 執行，速度較慢，不需要 bitsandbytes；
# 這顆模型在 Apple Silicon 的 MPS 上會直接當機，app/llm.py 已刻意跳過 MPS 強制用 CPU；
# 混合推理模型，預設用 enable_thinking=False 關掉思考過程，輸出仍常是簡體字，
# app/llm.py 的 generate() 會自動做簡轉繁）

# 前端網址，用於 CORS 設定，多個網址用逗號分隔
CORS_ORIGINS=http://localhost:5173

# RAG 檢索引擎：gemini/online（線上 Gemini embedding，不需要 torch）、
# llamaindex（LlamaIndex VectorStoreIndex + pgvector，本地 embedding）。
# llamaindex 需要另外安裝 requirements-local-llm.txt，見 backend/README.md「RAG 引擎切換」一節
# 留空不設定時會自動判斷：偵測到 GEMINI_API_KEY（或 llm_keys.json 的 google.api_key，GCP 部署會設定）
# 就用 gemini；本機沒有 key 時自動退回 llamaindex。要強制指定就取消註解下面這行。
# RAG_ENGINE=gemini

# llamaindex 引擎的 pgvector（PostgreSQL）連線設定，本機開發指向 docker 起的 pgvector：
# docker run -d --name rag-pgvector -e POSTGRES_PASSWORD=postgres -p 5432:5432 pgvector/pgvector:pg16
# 見 backend/README.md「本機開發：啟動 pgvector」一節的完整步驟
RAG_PG_HOST=localhost
RAG_PG_PORT=5432
RAG_PG_DATABASE=rag
RAG_PG_USER=postgres
RAG_PG_PASSWORD=postgres
RAG_PG_TABLE=kb_chunks
