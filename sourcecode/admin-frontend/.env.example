VITE_ADMIN_API_URL=http://localhost:8001
VITE_RAG_API_URL=http://localhost:8000
VITE_TENANT_NAME=CRM Select Demo
# 見 backend/.env 的 GOOGLE_CLIENT_ID，需填同一組 Google Cloud OAuth Client ID
VITE_GOOGLE_CLIENT_ID=
# chat-widget 的建置產物網址（本機開發用 vite preview 直接跑，見 chat-widget/README.md），
# RAG 頁面用來嵌入聊天機器人測試目前選定公司的回答，不設定時預設 http://localhost:5175/chat-widget.js
VITE_CHAT_WIDGET_URL=http://localhost:5175/chat-widget.js
